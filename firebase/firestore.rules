rules_version = '2';
// ==============================================================================
// 喫煙所マップアプリ Firebase Firestore セキュリティルール
// ==============================================================================
// 初心者向け解説:
// Firebase Console の「Firestore Database」->「ルール」に貼り付けて公開します。
// ログインユーザーのみが閲覧・投稿でき、未登録ユーザーはアクセスできない設定です。
// ==============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ログインしているかどうかの共通判定関数
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // 本人かどうかの判定関数
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users コレクション
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
    }

    // 2. SmokingAreas コレクション
    match /smoking_areas/{areaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.created_by == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.created_by == request.auth.uid;
    }

    // 3. Reviews コレクション
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }
  }
}
