# ==============================================================================
# 喫煙所マップアプリ 環境変数設定テンプレート
# ==============================================================================
# 初心者向け解説:
# このファイルをコピーして「.env」という名前に変更し、実際のAPIキーを入力してください。
# ※.envファイルはGitにはアップロードされない安全なファイルです。
# ==============================================================================

# 1. Google Maps JavaScript API キー
# Google Cloud Console で取得したAPIキーを入力します。
# （未設定の場合は、シミュレーション・デモモードで安全に動作確認できます）
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 2. Firebase 連携設定 (Firestore / Authentication / Storage)
# Firebase Console の「プロジェクトの設定」->「全般」->「マイアプリ」から取得します。
# （未設定の場合は、ブラウザ内ストレージで安全にデモ動作します）
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
